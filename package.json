{
  "name": "devforge-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "platform",
    "labs/angular",
    "labs/react",
    "labs/typescript"
  ],
  "scripts": {
    "start": "npm run dev:platform",
    "dev": "npm run dev:platform",
    "dev:platform": "npm run start --workspace=devforge-platform",
    "dev:angular": "npm run start --workspace=@devforge/angular",
    "dev:react": "npm run dev --workspace=@devforge/react",
    "dev:typescript": "npm run start --workspace=@devforge/typescript",
    "build": "npm run build --workspaces --if-present",
    "build:platform": "npm run build --workspace=devforge-platform",
    "build:angular": "npm run build --workspace=@devforge/angular",
    "build:react": "npm run build --workspace=@devforge/react",
    "build:typescript": "npm run build --workspace=@devforge/typescript",
    "test": "npm run test:platform && npm run test:angular && npm run test:react && npm run test:typescript",
    "test:platform": "npm run test --workspace=devforge-platform -- --watch=false --browsers=ChromeHeadless",
    "test:angular": "npm run test --workspace=@devforge/angular -- --watch=false --browsers=ChromeHeadless",
    "test:e2e:angular": "npm run test:e2e --workspace=@devforge/angular",
    "test:e2e:angular:ui": "npm run test:e2e:ui --workspace=@devforge/angular",
    "test:react": "npm run test --workspace=@devforge/react",
    "test:typescript": "npm run test --workspace=@devforge/typescript"
  }
}
